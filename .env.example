# Copy to .env and adjust. Every value below has a sensible local default.

# ─── Web app (Vite) ──────────────────────────────────────────────
VITE_APP_BASE_PATH=/issue-management   # base path the SPA is served under
VITE_API_URL=http://localhost:8080     # TriageKit API (Rust) base URL

# ─── API server (Rust) ───────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
PUBLIC_WEB_URL=http://localhost:5173   # where the web app is reachable (SSO redirects)
APP_BASE_PATH=/issue-management        # must match VITE_APP_BASE_PATH

TRIAGEKIT_APP_SECRET=dev-app-secret    # bearer token host apps use for SSO + provisioning
JWT_SECRET=change-me-in-production      # signs TriageKit session tokens

BOOTSTRAP_ADMIN_EMAIL=dev@example.com  # first owner account, seeded on startup
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# ─── Database ────────────────────────────────────────────────────
DB_BACKEND=mongo                       # "mongo" (default) or "postgres"

# MongoDB — used when DB_BACKEND=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=triagekit

# PostgreSQL — used when DB_BACKEND=postgres (tables auto-created on startup)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/triagekit

# ─── SSO login codes ─────────────────────────────────────────────
TOKEN_STORE=memory                     # "memory" (default) or "redis"
REDIS_URL=redis://127.0.0.1:6379       # only used when TOKEN_STORE=redis
REDIS_DB=12
REDIS_KEY_PREFIX=triagekit:local

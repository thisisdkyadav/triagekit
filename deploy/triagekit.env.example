# TriageKit configuration
#
# This file is read by systemd (EnvironmentFile=) and by scripts/install.sh.
# Format: KEY=value, one per line.
#
# IMPORTANT: systemd does NOT support trailing comments. Writing
#   DB_BACKEND=mongo   # the database
# makes the value "mongo   # the database". Keep comments on their own line.
# Quote any value containing spaces:  NAME="Some Thing"

# ─────────────────────────────────────────────────────────────
# Public URLs
# ─────────────────────────────────────────────────────────────
# Origin the web app is reachable at, no trailing slash.
# Used to build the SSO redirect URL.
PUBLIC_WEB_URL=https://example.com

# Base path nginx serves the SPA under.
# Must match VITE_APP_BASE_PATH below.
APP_BASE_PATH=/issue-management

# ─────────────────────────────────────────────────────────────
# API bind address
# ─────────────────────────────────────────────────────────────
# Keep on localhost and let nginx proxy to it.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ─────────────────────────────────────────────────────────────
# Secrets - install.sh generates these if the file is created fresh
# ─────────────────────────────────────────────────────────────
# Bearer token your host app uses for SSO + user provisioning.
TRIAGEKIT_APP_SECRET=CHANGE_ME

# Signs TriageKit session tokens (JWT).
JWT_SECRET=CHANGE_ME

# ─────────────────────────────────────────────────────────────
# First owner account, seeded on first start
# ─────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ─────────────────────────────────────────────────────────────
# Database - "mongo" (default) or "postgres"
# Schema/indexes are created automatically on first start.
# ─────────────────────────────────────────────────────────────
DB_BACKEND=mongo

# Used when DB_BACKEND=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=triagekit

# Used when DB_BACKEND=postgres
DATABASE_URL=postgres://triagekit:triagekit@127.0.0.1:5432/triagekit

# ─────────────────────────────────────────────────────────────
# SSO login codes: "memory" (single instance) or "redis"
# ─────────────────────────────────────────────────────────────
TOKEN_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=12
REDIS_KEY_PREFIX=triagekit

# ─────────────────────────────────────────────────────────────
# Web build settings
# These are baked into the JS bundle at BUILD time. After changing either,
# re-run scripts/install.sh so the frontend is rebuilt.
# ─────────────────────────────────────────────────────────────
# Leave EMPTY for same-origin (nginx serves the SPA and proxies /api on the
# same domain). Set to a full origin (https://api.example.com) only if the API
# lives on a different host than the web app.
VITE_API_URL=

VITE_APP_BASE_PATH=/issue-management
